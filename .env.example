# ── API ──────────────────────────────────────────────────────────────────────
# PostgreSQL 16 (ADR-004). docker compose up -d gives you this exact URL.
DATABASE_URL=postgresql://pharmatrack:pharmatrack@localhost:5432/pharmatrack_dev

# JWT (ADR-005). Generate real ones: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_HOURS=12

API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Africa's Talking SMS alerts (Week 5 integration). Leave empty for log-only
# mode; set the recipient via the `alert_phone` settings key.
AT_USERNAME=
AT_API_KEY=
AT_SENDER=

# ── Web ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
