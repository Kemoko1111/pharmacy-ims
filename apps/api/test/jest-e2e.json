{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json", "isolatedModules": true }]
  },
  "setupFiles": ["<rootDir>/env.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testTimeout": 30000
}
