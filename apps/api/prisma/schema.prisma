// PharmaTrack — Prisma schema, kept in lockstep with docs/week3/schema.sql
// (the authoritative DDL). Migrations are hand-written SQL under prisma/migrations
// so CHECK constraints, partial indexes, trigram indexes, and views survive.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  PHARMACIST
  INVENTORY_OFFICER
  CASHIER

  @@map("user_role")
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  SUPPOSITORY
  CONSUMABLE
  OTHER

  @@map("dosage_form")
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  QUARANTINED
  DEPLETED

  @@map("batch_status")
}

enum MovementType {
  OPENING
  RECEIPT
  SALE
  RETURN_IN
  ADJUSTMENT
  DISPOSAL

  @@map("movement_type")
}

enum PoStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED

  @@map("po_status")
}

enum SaleStatus {
  COMPLETED
  VOIDED

  @@map("sale_status")
}

enum PaymentMethod {
  CASH
  MOMO
  CARD

  @@map("payment_method")
}

enum AdjustmentReason {
  DAMAGE
  THEFT
  COUNT_CORRECTION
  EXPIRY_DISPOSAL
  SUPPLIER_RETURN
  OTHER

  @@map("adjustment_reason")
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED

  @@map("adjustment_status")
}

// ── People & access ──────────────────────────────────────────────────────────

model User {
  id           String    @id @db.Uuid
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  failedLogins Int       @default(0) @map("failed_logins") @db.SmallInt
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid

  creator        User?          @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers   User[]         @relation("UserCreatedBy")
  refreshTokens  RefreshToken[]
  sales          Sale[]
  stockMovements StockMovement[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  deviceLabel String?   @map("device_label")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ── Catalogue ────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
}

model Product {
  id               String     @id @db.Uuid
  name             String
  genericName      String?    @map("generic_name")
  strength         String?
  form             DosageForm @default(OTHER)
  categoryId       String     @map("category_id") @db.Uuid
  baseUnit         String     @map("base_unit")
  sellingPriceBase Decimal    @map("selling_price_base") @db.Decimal(12, 2)
  reorderLevel     Int        @default(0) @map("reorder_level")
  vatApplies       Boolean    @default(false) @map("vat_applies")
  prescriptionOnly Boolean    @default(false) @map("prescription_only")
  notes            String?
  legacyItemNo     String?    @map("legacy_item_no")
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?    @map("created_by") @db.Uuid
  updatedBy        String?    @map("updated_by") @db.Uuid

  category       Category            @relation(fields: [categoryId], references: [id])
  units          ProductUnit[]
  barcodes       ProductBarcode[]
  priceHistory   PriceHistory[]
  batches        Batch[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  adjustments    StockAdjustment[]
  poItems        PurchaseOrderItem[]
  receiptItems   GoodsReceiptItem[]

  @@map("products")
}

model ProductUnit {
  id           String   @id @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  unitName     String   @map("unit_name")
  factorToBase Int      @map("factor_to_base")
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product      Product          @relation(fields: [productId], references: [id])
  barcodes     ProductBarcode[]
  priceHistory PriceHistory[]
  saleItems    SaleItem[]

  @@unique([productId, unitName])
  @@map("product_units")
}

model ProductBarcode {
  id            String   @id @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productUnitId String?  @map("product_unit_id") @db.Uuid
  barcode       String   @unique
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product      @relation(fields: [productId], references: [id])
  unit    ProductUnit? @relation(fields: [productUnitId], references: [id])

  @@map("product_barcodes")
}

model PriceHistory {
  id            String   @id @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productUnitId String?  @map("product_unit_id") @db.Uuid
  oldPrice      Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice      Decimal  @map("new_price") @db.Decimal(12, 2)
  changedBy     String   @map("changed_by") @db.Uuid
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)

  product Product      @relation(fields: [productId], references: [id])
  unit    ProductUnit? @relation(fields: [productUnitId], references: [id])

  @@map("price_history")
}

// ── Suppliers & purchasing ───────────────────────────────────────────────────

model Supplier {
  id          String    @id @db.Uuid
  name        String
  contactName String?   @map("contact_name")
  phone       String?
  email       String?
  address     String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id @db.Uuid
  poNumber     String    @unique @map("po_number")
  supplierId   String    @map("supplier_id") @db.Uuid
  status       PoStatus  @default(DRAFT)
  expectedDate DateTime? @map("expected_date") @db.Date
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.Uuid

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @db.Uuid
  poId        String  @map("po_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  qtyBase     Int     @map("qty_base")
  unitCost    Decimal @map("unit_cost") @db.Decimal(12, 4)
  qtyReceived Int     @default(0) @map("qty_received")

  po      PurchaseOrder @relation(fields: [poId], references: [id])
  product Product       @relation(fields: [productId], references: [id])

  @@unique([poId, productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id         String   @id @db.Uuid
  grnNumber  String   @unique @map("grn_number")
  poId       String?  @map("po_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  receivedBy String   @map("received_by") @db.Uuid
  notes      String?

  po       PurchaseOrder?     @relation(fields: [poId], references: [id])
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  items    GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id        String  @id @db.Uuid
  receiptId String  @map("receipt_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  batchId   String  @map("batch_id") @db.Uuid
  qtyBase   Int     @map("qty_base")
  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 4)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  batch   Batch        @relation(fields: [batchId], references: [id])

  @@map("goods_receipt_items")
}

// ── Inventory ────────────────────────────────────────────────────────────────

model Batch {
  id          String      @id @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  batchNumber String      @map("batch_number")
  expiryDate  DateTime    @map("expiry_date") @db.Date
  qtyOnHand   Int         @default(0) @map("qty_on_hand")
  unitCost    Decimal     @default(0) @map("unit_cost") @db.Decimal(12, 4)
  status      BatchStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Product            @relation(fields: [productId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  adjustments    StockAdjustment[]
  receiptItems   GoodsReceiptItem[]

  @@unique([productId, batchNumber, expiryDate])
  @@map("batches")
}

model StockAdjustment {
  id          String           @id @db.Uuid
  productId   String           @map("product_id") @db.Uuid
  batchId     String           @map("batch_id") @db.Uuid
  qtyDelta    Int              @map("qty_delta")
  reason      AdjustmentReason
  note        String?
  status      AdjustmentStatus @default(PENDING_APPROVAL)
  requestedBy String           @map("requested_by") @db.Uuid
  approvedBy  String?          @map("approved_by") @db.Uuid
  decidedAt   DateTime?        @map("decided_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])

  @@map("stock_adjustments")
}

model StockMovement {
  id          BigInt       @id @default(autoincrement())
  productId   String       @map("product_id") @db.Uuid
  batchId     String       @map("batch_id") @db.Uuid
  qtyDelta    Int          @map("qty_delta")
  type        MovementType
  refType     String       @map("ref_type")
  refId       String       @map("ref_id") @db.Uuid
  unitCost    Decimal      @default(0) @map("unit_cost") @db.Decimal(12, 4)
  performedBy String       @map("performed_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product @relation(fields: [productId], references: [id])
  batch     Batch   @relation(fields: [batchId], references: [id])
  performer User    @relation(fields: [performedBy], references: [id])

  @@index([productId, createdAt(sort: Desc)], map: "ix_mov_product")
  @@index([refType, refId], map: "ix_mov_ref")
  @@map("stock_movements")
}

// ── Customers & sales ────────────────────────────────────────────────────────

model Customer {
  id        String    @id @db.Uuid
  fullName  String    @map("full_name")
  phone     String?   @unique
  notes     String?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sales Sale[]

  @@map("customers")
}

model Sale {
  id            String     @id @db.Uuid
  clientSaleId  String     @unique @map("client_sale_id") @db.Uuid
  receiptNumber String     @unique @map("receipt_number")
  cashierId     String     @map("cashier_id") @db.Uuid
  customerId    String?    @map("customer_id") @db.Uuid
  subtotal      Decimal    @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @map("discount_total") @db.Decimal(12, 2)
  vatTotal      Decimal    @default(0) @map("vat_total") @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  status        SaleStatus @default(COMPLETED)
  syncedOffline Boolean    @default(false) @map("synced_offline")
  soldAt        DateTime   @map("sold_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  cashier  User         @relation(fields: [cashierId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments Payment[]
  returns  SaleReturn[]

  @@index([soldAt(sort: Desc)], map: "ix_sales_sold_at")
  @@index([cashierId, soldAt(sort: Desc)], map: "ix_sales_cashier")
  @@map("sales")
}

model SaleItem {
  id            String   @id @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productUnitId String?  @map("product_unit_id") @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  quantity      Int
  qtyBase       Int      @map("qty_base")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale        Sale             @relation(fields: [saleId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])
  unit        ProductUnit?     @relation(fields: [productUnitId], references: [id])
  batch       Batch            @relation(fields: [batchId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId], map: "ix_sale_items_sale")
  @@index([productId, createdAt], map: "ix_sale_items_product")
  @@map("sale_items")
}

model Payment {
  id        String        @id @db.Uuid
  saleId    String        @map("sale_id") @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  tendered  Decimal?      @db.Decimal(12, 2)
  changeDue Decimal?      @map("change_due") @db.Decimal(12, 2)
  momoRef   String?       @map("momo_ref")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("payments")
}

model SaleReturn {
  id          String   @id @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  reason      String
  refundTotal Decimal  @map("refund_total") @db.Decimal(12, 2)
  approvedBy  String   @map("approved_by") @db.Uuid
  processedBy String   @map("processed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale  Sale             @relation(fields: [saleId], references: [id])
  items SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id           String  @id @db.Uuid
  saleReturnId String  @map("sale_return_id") @db.Uuid
  saleItemId   String  @map("sale_item_id") @db.Uuid
  qtyBase      Int     @map("qty_base")
  restock      Boolean @default(true)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@map("sale_return_items")
}

// ── Cross-cutting ────────────────────────────────────────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId, createdAt(sort: Desc)], map: "ix_audit_entity")
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model Notification {
  id        String    @id @db.Uuid
  type      String
  payload   Json
  seenAt    DateTime? @map("seen_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("notifications")
}
